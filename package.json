{
  "name": "pigeon-api-studio",
  "version": "0.1.0",
  "description": "Pigeon is a cross-platform HTTP request management desktop application for Windows, macOS and Linux",
  "main": "./out/main/index.js",
  "author": "Chen Su",
  "homepage": "https://github.com/ghosind/pigeon",
  "repository": {
    "url": "https://github.com/ghosind/pigeon"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "build:unpack": "pnpm build && electron-builder --dir --publish never",
    "build:mac": "pnpm build && electron-builder --mac --publish never",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "build:linux": "pnpm build && electron-builder --linux --publish never",
    "lint": "oxlint src --deny-warnings",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "node scripts/prepare-husky.mjs",
    "ci": "pnpm i18n:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "iconv-lite": "^0.7.3",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "husky": "^9.1.7",
    "lucide-react": "^1.67.0",
    "monaco-editor": "^0.56.0",
    "oxlint": "^1.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
